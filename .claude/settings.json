{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "statusLine": {
    "type": "command",
    "command": "\"$CLAUDE_PROJECT_DIR\"/harness/statusline.sh",
    "refreshInterval": 60
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/harness/hooks/stop.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/harness/hooks/notify.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/harness/hooks/activity.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/harness/hooks/activity.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/harness/hooks/guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bin/vqcc-verify *)",
      "Bash(bin/vqcc-remote *)",
      "Bash(bin/vqcc-best*)",
      "Bash(bin/vqcc-model *)",
      "Bash(bin/vqcc-standing*)",
      "Bash(bin/vqcc-compute*)",
      "Bash(bin/vqcc-discussions*)",
      "Bash(git -C work *)",
      "Bash(mkdir -p work/*)",
      "Bash(cp data/intel/outputs/* work/*)",
      "Bash(unzip -q data/intel/outputs/* -d work/*)",
      "Bash(clang++ *)",
      "Bash(nice -n 10 clang++ *)",
      "Bash(c++ *)",
      "Bash(g++ *)",
      "Read(./**)",
      "Edit(./work/**)",
      "Write(./work/**)"
    ],
    "deny": [
      "Read(~/.kaggle/**)",
      "Bash(cat ~/.kaggle*)",
      "Bash(*~/.kaggle*)",
      "Bash(*/.kaggle/*)",
      "Edit(~/.kaggle/**)",
      "Write(~/.kaggle/**)",
      "Bash(kaggle competitions submit*)",
      "Bash(bin/vqcc-submit*)",
      "Bash(*harness/submit.py*)",
      "Bash(launchctl *)",
      "Bash(bin/night-supervisor*)",
      "Bash(git push*)",
      "Bash(gh *)",
      "Edit(./data/**)",
      "Write(./data/**)",
      "Edit(./ledger/**)",
      "Write(./ledger/**)",
      "Edit(./models/**)",
      "Write(./models/**)"
    ]
  }
}
