#!/bin/bash
# Install (or remove with --uninstall) the LaunchAgent that starts bin/night-supervisor every
# night at VQCC_WINDOW_START. The supervisor itself exits when outside the window.
set -eu
ROOT="$(cd "$(dirname "$0")/.." >/dev/null 2>&1 && pwd -P)"
. "$ROOT/harness/config.sh"
LABEL="com.rikeda71.vqcc-harness"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
DOMAIN="gui/$(id -u)"

if [ "${1:-}" = "--uninstall" ]; then
  launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true
  rm -f "$PLIST"; echo "removed $PLIST"; exit 0
fi

H=$((10#${VQCC_WINDOW_START:0:2})); M=$((10#${VQCC_WINDOW_START:2:2}))
mkdir -p "$HOME/Library/LaunchAgents" "$VQCC_STATE/logs"
cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>$ROOT/bin/night-supervisor</string></array>
  <key>WorkingDirectory</key><string>$ROOT</string>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>$H</integer><key>Minute</key><integer>$M</integer></dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>$HOME/.local/bin:/opt/homebrew/bin:/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>LANG</key><string>ja_JP.UTF-8</string>
  </dict>
  <key>StandardOutPath</key><string>$VQCC_STATE/logs/launchd.out.log</string>
  <key>StandardErrorPath</key><string>$VQCC_STATE/logs/launchd.err.log</string>
  <key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
EOF
plutil -lint "$PLIST"
launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true
launchctl bootstrap "$DOMAIN" "$PLIST"
echo "installed $PLIST (daily at $H:$(printf %02d "$M"))"
launchctl print "$DOMAIN/$LABEL" | grep -E "state|path" | head -5
