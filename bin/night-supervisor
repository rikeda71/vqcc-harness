#!/bin/bash
# Night supervisor: started every night at the window start by the LaunchAgent that
# `bin/vqcc-schedule start` (skill /vqcc-night) registers, or by hand. Runs in the foreground
# until the window closes, keeping one interactive Claude Code worker per task alive in a herdr
# session (named session "vqcc", one tab per worker).
#
#   bin/night-supervisor            run (exits immediately when outside the night window, or when
#                                   the schedule is disabled: state/DISABLED)
#   bin/night-supervisor --force    run even outside the window (testing; still obeys usage guard;
#                                   never submits and never disables the schedule)
#
# The schedule disables itself (state/DISABLED + LaunchAgent removed) when the competition is over
# or Kaggle stays unreachable (harness/kaggle_health.py).
#
# Observe:  herdr --session vqcc     (attach the TUI)     logs: state/logs/supervisor.log
# Stop now: touch state/STOP          (workers get ~5 min to wrap up, then are closed; supervisor exits)
set -u
# The whole body is one brace group so bash parses it before running: editing or pulling this
# file while a night is in progress cannot corrupt the running supervisor.
{
ROOT="$(cd "$(dirname "$0")/.." >/dev/null 2>&1 && pwd -P)"
. "$ROOT/harness/config.sh"
cd "$ROOT" || exit 1

FORCE=0; [ "${1:-}" = "--force" ] && FORCE=1
in_window() { [ "$FORCE" = 1 ] || vqcc_in_window; }

LOCK="$VQCC_STATE/supervisor.pid"
if [ -f "$LOCK" ] && kill -0 "$(cat "$LOCK")" 2>/dev/null; then
  echo "supervisor already running (pid $(cat "$LOCK"))"; exit 0
fi
echo $$ > "$LOCK"
trap 'rm -f "$LOCK"' EXIT

# Unloading our own LaunchAgent job kills this process, so it is always the last thing we do.
unload_if_disabled() {
  [ "$FORCE" = 0 ] && [ -f "$VQCC_STATE/DISABLED" ] && launchctl bootout "gui/$(id -u)/$VQCC_LAUNCHD_LABEL" >/dev/null 2>&1
}
end_schedule() {  # $1 = reason; testing runs (--force) only log it
  if [ "$FORCE" = 0 ]; then vqcc_disable "$1"; else vqcc_log "supervisor: (--force, schedule untouched) $1"; fi
}
if [ "$FORCE" = 0 ] && [ -f "$VQCC_STATE/DISABLED" ]; then
  vqcc_log "supervisor: schedule disabled ($(cat "$VQCC_STATE/DISABLED")); exit"
  rm -f "$LOCK"; unload_if_disabled; exit 0
fi
in_window || { vqcc_log "supervisor: outside window ($VQCC_WINDOW_START-$VQCC_WINDOW_END), exit"; exit 0; }
rm -f "$VQCC_STATE/STOP"

# Keep the Mac awake while we run.
caffeinate -dimsu -w $$ &

# Is the competition still running and Kaggle reachable? (0 ok, 1 unreachable, 3 over)
kaggle_check() { KH=$("$ROOT/harness/pyrun" "$ROOT/harness/kaggle_health.py" 2>&1); KRC=$?; }
for i in $(seq 1 "$VQCC_KAGGLE_START_RETRIES"); do
  kaggle_check; [ "$KRC" != 1 ] && break
  vqcc_log "supervisor: kaggle check failed ($i/$VQCC_KAGGLE_START_RETRIES): $KH"
  [ -f "$VQCC_STATE/STOP" ] && break
  [ "$i" -lt "$VQCC_KAGGLE_START_RETRIES" ] && sleep 300
done
if [ "$KRC" != 0 ]; then
  if [ -f "$VQCC_STATE/STOP" ]; then vqcc_log "supervisor: STOP during kaggle check"
  elif [ "$KRC" = 3 ]; then end_schedule "competition over: $KH"
  else end_schedule "Kaggle unreachable at night start: $KH"; fi
  vqcc_log "supervisor: not starting tonight"
  rm -f "$LOCK"; unload_if_disabled; exit 0
fi
vqcc_log "supervisor: kaggle $KH"
NIGHT_ID="$(date +%Y%m%d-%H%M)"
echo "$NIGHT_ID" > "$VQCC_STATE/night_id"
vqcc_log "supervisor: start night $NIGHT_ID workers=[$VQCC_WORKERS] usage=$(vqcc_usage)"

S="$VQCC_HERDR_SESSION"
hd() { herdr --session "$S" "$@"; }
wfile() { echo "$VQCC_STATE/workers/$1/$2"; }
wpane() { cat "$(wfile "$1" pane)" 2>/dev/null; }

# A fresh herdr session every night (a named session otherwise restores last night's layout).
herdr_up() {
  herdr session stop "$S" --json >/dev/null 2>&1
  herdr session delete "$S" --json >/dev/null 2>&1
  herdr --session "$S" server >> "$VQCC_STATE/logs/herdr-server.out" 2>&1 &
  local i out
  for i in $(seq 1 60); do hd workspace list >/dev/null 2>&1 && break; sleep 0.5; done
  out=$(hd workspace create --cwd "$ROOT" --label vqcc --no-focus) || return 1
  WS=$(printf '%s' "$out" | jq -r '.result.workspace.workspace_id')
  hd tab rename "$(printf '%s' "$out" | jq -r '.result.tab.tab_id')" supervisor >/dev/null 2>&1
  hd pane run "$(printf '%s' "$out" | jq -r '.result.root_pane.pane_id')" \
    "tail -n 200 -F state/logs/supervisor.log" >/dev/null
}
herdr_up || { vqcc_log "supervisor: could not start herdr session $S; exit"; exit 1; }

# Alive = something other than the pane's shell is in the foreground (claude, or the launcher).
worker_alive() {
  local p; p=$(wpane "$1"); [ -n "$p" ] || return 1
  hd pane process-info --pane "$p" 2>/dev/null | \
    jq -e '.result.process_info | .foreground_process_group_id != .shell_pid' >/dev/null 2>&1
}

# Save the pane's recent output to state/logs/<prefix>-<worker>-<epoch>.txt.
snapshot() {  # $1 worker, $2 prefix, $3 lines
  local p; p=$(wpane "$1"); [ -n "$p" ] || return 0
  hd pane read "$p" --source recent-unwrapped --lines "$3" > "$VQCC_STATE/logs/$2-$1-$(date +%s).txt" 2>/dev/null
}

close_worker() {  # interrupt the worker, keep its last screen in the logs, close its tab
  local w="$1" p t; p=$(wpane "$w"); t=$(cat "$(wfile "$w" tab)" 2>/dev/null)
  [ -n "$p" ] || return 0
  hd pane send-keys "$p" esc >/dev/null 2>&1; sleep 1
  hd pane send-keys "$p" ctrl+c >/dev/null 2>&1; sleep 1
  hd pane send-keys "$p" ctrl+c >/dev/null 2>&1; sleep 2
  snapshot "$w" final 300
  [ -n "$t" ] && hd tab close "$t" >/dev/null 2>&1
  rm -f "$(wfile "$w" pane)" "$(wfile "$w" tab)"
}

start_worker() {  # $1 worker, $2 = "fresh" for a new session after a context rotation
  local w="$1" wdir="$VQCC_STATE/workers/$1" resume_id="" out p
  mkdir -p "$wdir" "$ROOT/work/$w"
  rm -f "$wdir/STOP" "$wdir/waiting" "$wdir/continues" "$wdir/rotate" "$wdir/rotate_asked" "$wdir/rotate_wait"
  # A worker restarted before the wrap-up window must get the wrap-up instruction again.
  [ "$(vqcc_min_to_end)" -gt "$VQCC_WRAPUP_MIN" ] && rm -f "$wdir/wrapup_sent"
  if [ "${2:-}" = fresh ]; then
    rm -f "$wdir/session_id"; resume_id=fresh
  elif [ -s "$wdir/session_id" ] && [ "$(cat "$wdir/night_id" 2>/dev/null)" = "$NIGHT_ID" ]; then
    resume_id="$(cat "$wdir/session_id")"
  else
    rm -f "$wdir/session_id"
  fi
  echo "$NIGHT_ID" > "$wdir/night_id"
  # The worker reads DIRECTIVE.md at session start; activity.sh announces only later updates.
  [ -f "$ROOT/work/$w/DIRECTIVE.md" ] && /usr/bin/stat -f %m "$ROOT/work/$w/DIRECTIVE.md" > "$wdir/directive_seen"
  close_worker "$w"
  out=$(hd tab create --workspace "$WS" --label "w-$w" --cwd "$ROOT" --no-focus) || {
    vqcc_log "supervisor: herdr tab create failed for $w"; return 1; }
  p=$(printf '%s' "$out" | jq -r '.result.root_pane.pane_id')
  printf '%s' "$out" | jq -r '.result.tab.tab_id' > "$wdir/tab"
  echo "$p" > "$wdir/pane"
  # The pane runs the user's login shell; the launcher builds the prompt and execs claude.
  # When claude exits the shell prints a marker and stays, so the last screen can be read.
  hd pane run "$p" "harness/worker-launch.sh ${w} ${NIGHT_ID} ${resume_id}; echo \"[vqcc] worker exited rc=\$?\"" >/dev/null
  date +%s > "$wdir/started"
  date +%s > "$wdir/heartbeat"
  vqcc_log "supervisor: started worker $w in $p ${resume_id:+($resume_id)}"
}

# Strategist ("作戦会議"): a separate, non-circuit Claude session that reads the standing
# (bin/vqcc-standing), every task's progress and public intel, then rewrites work/STRATEGY.md and
# work/<task>/DIRECTIVE.md (skill planning-vqcc-strategy). Runs at night start and every
# VQCC_STRATEGY_INTERVAL_MIN; its Stop hook ends it after one pass (state/workers/strategist/done).
STRAT=strategist
start_strategist() {  # $1 = optional trigger note handed to the strategist prompt
  local wdir="$VQCC_STATE/workers/$STRAT" out p
  mkdir -p "$wdir"; rm -f "$wdir/done" "$wdir/waiting" "$wdir/stop_reason" "$wdir/sent_back" "$wdir/trigger"
  [ -n "${1:-}" ] && printf '%s\n' "$1" > "$wdir/trigger"
  close_worker "$STRAT"
  "$ROOT/bin/vqcc-discussions" sync > "$VQCC_STATE/logs/discussions.log" 2>&1 || vqcc_log "supervisor: vqcc-discussions sync failed ($(tail -n 1 "$VQCC_STATE/logs/discussions.log"))"
  "$ROOT/bin/vqcc-standing" > "$VQCC_STATE/logs/standing.log" 2>&1 || vqcc_log "supervisor: vqcc-standing failed ($(tail -n 1 "$VQCC_STATE/logs/standing.log"))"
  out=$(hd tab create --workspace "$WS" --label "$STRAT" --cwd "$ROOT" --no-focus) || {
    vqcc_log "supervisor: herdr tab create failed for $STRAT"; return 1; }
  p=$(printf '%s' "$out" | jq -r '.result.root_pane.pane_id')
  printf '%s' "$out" | jq -r '.result.tab.tab_id' > "$wdir/tab"
  echo "$p" > "$wdir/pane"
  hd pane run "$p" "harness/worker-launch.sh ${STRAT} ${NIGHT_ID}; echo \"[vqcc] strategist exited rc=\$?\"" >/dev/null
  date +%s > "$wdir/started"; date +%s > "$wdir/heartbeat"
  vqcc_log "supervisor: started strategist in $p"
}
strategy_tick() {  # $1 = now
  [ "$VQCC_STRATEGY_INTERVAL_MIN" -gt 0 ] 2>/dev/null || return 0
  local wdir="$VQCC_STATE/workers/$STRAT" st wts wtype
  if [ -n "$(wpane "$STRAT")" ]; then
    st=$(cat "$wdir/started" 2>/dev/null || echo "$1")
    if [ -f "$wdir/done" ]; then
      vqcc_log "supervisor: strategist done after $(( ($1 - st) / 60 )) min"; close_worker "$STRAT"
    elif ! worker_alive "$STRAT"; then
      vqcc_log "supervisor: strategist exited"; snapshot "$STRAT" dead 200; close_worker "$STRAT"
    elif [ $(( $1 - st )) -ge $(( VQCC_STRATEGY_TIMEOUT_MIN * 60 )) ]; then
      vqcc_log "supervisor: strategist timed out after $VQCC_STRATEGY_TIMEOUT_MIN min"; close_worker "$STRAT"
    elif [ -f "$wdir/waiting" ]; then
      read -r wts wtype < "$wdir/waiting"
      if [ $(( $1 - wts )) -ge 180 ]; then
        rm -f "$wdir/waiting"
        if [ "$wtype" = permission_prompt ]; then
          nudge "$STRAT" "(supervisor) 承認者はいません。拒否されたものとして扱い、許可された手段で作戦会議を完了し、STRATEGY.md と DIRECTIVE.md を書いて停止してください。"
        else
          nudge "$STRAT" "(supervisor) 入力待ちのまま止まっています (承認待ちの操作はありません)。作戦会議を完了し、STRATEGY.md と DIRECTIVE.md を書いて停止してください。"
        fi
      fi
    fi
  elif [ $(( $1 - STRAT_LAST )) -ge $(( VQCC_STRATEGY_INTERVAL_MIN * 60 )) ] && [ "$(vqcc_min_to_end)" -gt 60 ]; then
    STRAT_LAST=$1; start_strategist
  elif [ $(( $1 - STRAT_LAST )) -ge $(( VQCC_STRATEGY_IDLE_GAP_MIN * 60 )) ] && [ "$(vqcc_min_to_end)" -gt 60 ]; then
    # A worker parked after the last pass: bring the next pass forward (once per newly parked worker).
    local w im
    st=$(cat "$wdir/started" 2>/dev/null || echo 0)
    for w in $VQCC_WORKERS; do
      im=$(/usr/bin/stat -f %m "$ROOT/work/$w/IDLE" 2>/dev/null || echo 0)
      if vqcc_parked "$w" && [ "$im" -gt "$st" ]; then
        vqcc_log "supervisor: $w parked (directive exhausted); strategist pass brought forward"
        STRAT_LAST=$1; start_strategist; break
      fi
    done
    # Every worker is parked and the last pass woke none of them: the night would stall until the
    # next interval. Re-run the strategist (at most VQCC_STRATEGY_ALL_PARKED_MAX times a night).
    if [ -z "$(wpane "$STRAT")" ] && [ "$STRAT_ALLPARKED" -lt "$VQCC_STRATEGY_ALL_PARKED_MAX" ]; then
      for w in $VQCC_WORKERS; do vqcc_parked "$w" || return 0; done
      STRAT_ALLPARKED=$(( STRAT_ALLPARKED + 1 ))
      vqcc_log "supervisor: all workers parked; strategist re-run ($STRAT_ALLPARKED/$VQCC_STRATEGY_ALL_PARKED_MAX)"
      STRAT_LAST=$1
      start_strategist "all-parked: 全ワーカー ($VQCC_WORKERS) が待機中で、前回の作戦会議はどのワーカーも再開させていません。夜間ウィンドウの残りは約 $(vqcc_min_to_end) 分です。少なくとも 1 タスクに、前回までに試していない進捗の出る実験 (Step 2b の自前の抜本策を含む) を DIRECTIVE.md で指令してください。"
    fi
  fi
}

stop_workers() {  # $1 = reason
  local w
  for w in $VQCC_WORKERS $STRAT; do close_worker "$w"; done
  vqcc_log "supervisor: stopped workers ($1)"
}

# A parked worker does not wait for its in-flight remote/full runs. When they have all finished (new
# ledger records since IDLE, no job of the task still queued/running), move IDLE to
# state/workers/<w>/IDLE.woken and write state/workers/<w>/woken ("<epoch> <results>"): the worker's
# background wait (until IDLE is gone) wakes it, or it is restarted / nudged below. It handles the
# results and parks again; a new IDLE clears the woken files.
wake_parked() {  # $1 worker
  local w="$1" wdir="$VQCC_STATE/workers/$1" msg
  [ "$ROOT/ledger/results.jsonl" -nt "$ROOT/work/$w/IDLE" ] || return 1
  msg=$("$ROOT/harness/pyrun" "$ROOT/harness/workers.py" wake-check "$w" 2>/dev/null) || return 1
  mv "$ROOT/work/$w/IDLE" "$wdir/IDLE.woken" || return 1
  echo "$(date +%s) $msg" > "$wdir/woken"; rm -f "$wdir/woken_nudged"
  vqcc_log "supervisor: woke parked $w (results arrived: $msg)"
}
WAKE_MSG="(supervisor) 待機中に検証結果が出たので起こしました (state/workers/WORKER/woken)。skill optimizing-vqcc-circuits の「Park」4 に従い、state/workers/WORKER/IDLE.woken の待ち条件どおりに結果を処理してから、再び待機してください。"

nudge() {  # $1 worker, $2 text
  local p; p=$(wpane "$1"); [ -n "$p" ] || return 0
  hd pane send-keys "$p" esc >/dev/null 2>&1; sleep 1
  hd pane send-text "$p" "$2" >/dev/null 2>&1; sleep 0.5
  hd pane send-keys "$p" enter >/dev/null 2>&1
  vqcc_log "supervisor: nudged $1"
}

STRAT_LAST=0; STRAT_ALLPARKED=0; PAUSED=0; LAST_POLL=0; KFAIL=0; END_REASON=""; SUBMITTED_TONIGHT=0; LAST_SUBMIT_TRY=0; START_TS=$(date +%s)
for w in $VQCC_WORKERS; do
  mkdir -p "$VQCC_STATE/workers/$w"; echo 0 > "$VQCC_STATE/workers/$w/restarts"
  rm -f "$VQCC_STATE/workers/$w/woken" "$VQCC_STATE/workers/$w/IDLE.woken" "$VQCC_STATE/workers/$w/woken_nudged"
done

if vqcc_over_limit; then
  PAUSED=1; vqcc_log "supervisor: usage over limit at start ($(vqcc_usage)); waiting for reset"
else
  for w in $VQCC_WORKERS; do start_worker "$w"; sleep 20; done
fi

while :; do
  sleep 60
  now=$(date +%s)

  if [ -f "$VQCC_STATE/STOP" ]; then
    vqcc_log "supervisor: STOP file"; sleep 300; stop_workers "STOP file"; break
  fi

  if ! in_window; then
    vqcc_log "supervisor: window closed; grace period"
    sleep 300
    stop_workers "window closed"; break
  fi

  # Usage guard (Claude subscription 5h / 7d windows).
  if vqcc_over_limit; then
    if [ "$PAUSED" = 0 ]; then
      PAUSED=1; stop_workers "usage guard $(vqcc_usage)"
      osascript -e 'display notification "Claude usage guard tripped; workers paused" with title "vqcc-harness"' 2>/dev/null
    fi
    if [ "$VQCC_RESUME_AFTER_RESET" != 1 ]; then vqcc_log "supervisor: no resume configured; exit"; break; fi
    continue
  fi
  if [ "$PAUSED" = 1 ]; then
    # Usage data is stale while no session runs; resume only after the 5h window's reset time.
    read -r five resets seven age < <(vqcc_usage)
    if [ "$resets" = "-" ] || [ "$now" -gt $(( resets + 120 )) ]; then
      PAUSED=0; vqcc_log "supervisor: resuming after reset"
      for w in $VQCC_WORKERS; do start_worker "$w"; sleep 20; done
    fi
    continue
  fi

  for w in $VQCC_WORKERS; do
    wdir="$VQCC_STATE/workers/$w"
    # Rotation deferred by the Stop hook for a running background subagent: rotate once the subagent
    # transcripts and the worker have been quiet for VQCC_SUBAGENT_IDLE_MIN minutes (the subagent ended
    # or hung without waking the session), or after VQCC_ROTATE_WAIT_MAX_MIN minutes at most.
    if [ -f "$wdir/rotate_wait" ] && [ ! -f "$wdir/rotate" ]; then
      sd=$(cat "$wdir/rotate_wait"); idle_s=$(( VQCC_SUBAGENT_IDLE_MIN * 60 ))
      age_w=$(( now - $(/usr/bin/stat -f %m "$wdir/rotate_wait" 2>/dev/null || echo "$now") ))
      age_hb=$(( now - $(cat "$wdir/heartbeat" 2>/dev/null || echo 0) ))
      if [ "$age_w" -ge $(( VQCC_ROTATE_WAIT_MAX_MIN * 60 )) ] || { [ "$age_hb" -ge "$idle_s" ] && \
           [ -z "$(find "$sd" -name 'agent-*.jsonl' -mmin -"$VQCC_SUBAGENT_IDLE_MIN" 2>/dev/null | head -1)" ]; }; then
        echo "context $(cat "$wdir/rotate_asked" 2>/dev/null) tokens, after waiting $(( age_w / 60 )) min for a subagent" > "$wdir/rotate"
        rm -f "$wdir/rotate_wait"
      fi
    fi
    # Context rotation: the Stop hook let the worker end after it handed off via NOTES.md.
    # Start a fresh session (not a restart: no budget used, no --resume).
    if [ -f "$wdir/rotate" ]; then
      vqcc_log "supervisor: rotating $w to a fresh session ($(cat "$wdir/rotate"))"
      close_worker "$w"
      start_worker "$w" fresh
      continue
    fi
    # Woken worker parked again: the new IDLE supersedes the woken files.
    if [ -f "$wdir/woken" ] && [ "$ROOT/work/$w/IDLE" -nt "$wdir/woken" ]; then
      rm -f "$wdir/woken" "$wdir/IDLE.woken" "$wdir/woken_nudged"
    fi
    if vqcc_parked "$w" && wake_parked "$w" && ! worker_alive "$w" && [ ! -f "$wdir/STOP" ]; then
      start_worker "$w"; continue  # a wake is not a crash: no restart budget used
    fi
    if ! worker_alive "$w"; then
      if [ -f "$wdir/STOP" ]; then continue; fi
      # Parked (directive exhausted): stay down until the strategist rewrites DIRECTIVE.md.
      if vqcc_parked "$w"; then continue; fi
      rs=$(( $(cat "$wdir/restarts" 2>/dev/null || echo 0) + 1 )); echo "$rs" > "$wdir/restarts"
      snapshot "$w" dead 200
      if [ "$rs" -le 6 ]; then
        vqcc_log "supervisor: worker $w not alive, restart #$rs"
        sleep $(( 30 * $rs ))
        start_worker "$w"
      elif [ "$rs" -eq 7 ]; then
        vqcc_log "supervisor: worker $w exceeded restart budget; leaving it down"
      fi
      continue
    fi
    # Parked (directive exhausted): idle at the prompt on purpose; nothing to watch.
    if vqcc_parked "$w"; then rm -f "$wdir/waiting"; continue; fi
    # Subscription limit message on screen (five_hour is not always present in the status line).
    if hd pane read "$(wpane "$w")" --source visible 2>/dev/null | grep -v '^[[:space:]]*$' | tail -12 | \
       grep -Eqi "hit your (session |weekly |5-hour )?limit|(usage|session|5-hour|weekly) limit (reached|will reset)|limit reached.*resets"; then
      echo "$now" > "$VQCC_STATE/limit_hit"
      vqcc_log "supervisor: limit message in w-$w pane; pausing all workers for 1h"
      break
    fi
    # Waiting on a permission prompt / idle input for a while -> nudge.
    # Only a permission_prompt means an operation is pending approval. An idle_prompt while the
    # rotation waits for a background subagent (rotate_wait) is expected: its completion wakes the
    # session, so leave it alone. Any other idle_prompt gets a plain "continue" (no approval wording).
    if [ -f "$wdir/waiting" ]; then
      read -r wts wtype < "$wdir/waiting"
      if [ "$wtype" = idle_prompt ] && [ -f "$wdir/rotate_wait" ]; then
        rm -f "$wdir/waiting"
      elif [ $(( now - wts )) -ge 180 ]; then
        rm -f "$wdir/waiting"
        if [ "$wtype" = permission_prompt ]; then
          nudge "$w" "(supervisor) 直前の操作は承認待ちですが、承認者はいません。拒否されたものとして扱い、許可されている手段 (bin/vqcc-* や work/ 内のスクリプト) で代替して作業を続行してください。"
        else
          nudge "$w" "(supervisor) 入力待ちのまま止まっています (承認待ちの操作はありません)。work/${w}/NOTES.md の「次にやること」から作業を続行してください。待機すべき状態 (Park / 切り替え待ち) なら、その旨を NOTES.md に書いて停止してください。"
        fi
      fi
    fi
    # Woken for finished results: its wait command should have fired; if nothing happened for 3 min, nudge once.
    hb=$(cat "$wdir/heartbeat" 2>/dev/null || echo "$now")
    if [ -f "$wdir/woken" ] && [ ! -f "$wdir/woken_nudged" ]; then
      read -r wk _ < "$wdir/woken"
      if [ $(( now - wk )) -ge 180 ] && [ "$hb" -lt "$wk" ]; then
        touch "$wdir/woken_nudged"; nudge "$w" "${WAKE_MSG//WORKER/$w}"
      fi
    fi
    # Unparked by a new DIRECTIVE.md: the worker's background wait command should wake it; if that
    # command is gone (e.g. after a resume) and nothing happened for 5 min, nudge once per update.
    hb=$(cat "$wdir/heartbeat" 2>/dev/null || echo "$now")
    dm=$(/usr/bin/stat -f %m "$ROOT/work/$w/DIRECTIVE.md" 2>/dev/null || echo 0)
    if [ -f "$ROOT/work/$w/IDLE" ]; then
      if [ $(( now - dm )) -ge 300 ] && [ "$hb" -lt "$dm" ] && [ "$(cat "$wdir/unpark_nudged" 2>/dev/null)" != "$dm" ]; then
        echo "$dm" > "$wdir/unpark_nudged"
        nudge "$w" "(supervisor) 作戦参謀が work/${w}/DIRECTIVE.md を更新しました。work/${w}/IDLE を削除し、skill optimizing-vqcc-circuits Step 2 に従って新しい指令で作業を再開してください。"
      fi
      continue  # the heartbeat is old from the parked time; skip the stale check until the worker resumes
    fi
    # No activity for 40 minutes: the session may be stuck (long tool call is fine, but check).
    if [ $(( now - hb )) -ge 2400 ]; then
      snapshot "$w" stale 60
      vqcc_log "supervisor: worker $w no heartbeat for $(( (now - hb) / 60 )) min (snapshot saved)"
      date +%s > "$wdir/heartbeat"
    fi
  done

  strategy_tick "$now"

  # Every 10 minutes: is the competition still on and Kaggle reachable? Then poll remote jobs.
  if [ $(( now - LAST_POLL )) -ge 600 ]; then
    LAST_POLL=$now
    kaggle_check
    if [ "$KRC" = 3 ]; then
      END_REASON="competition over: $KH"
    elif [ "$KRC" != 0 ]; then
      KFAIL=$(( KFAIL + 1 )); vqcc_log "supervisor: kaggle check failed ($KFAIL/$VQCC_KAGGLE_FAIL_MAX): $KH"
      [ "$KFAIL" -ge "$VQCC_KAGGLE_FAIL_MAX" ] && END_REASON="Kaggle unreachable for $KFAIL checks: $KH"
    else
      KFAIL=0
    fi
    if [ -n "$END_REASON" ]; then
      end_schedule "$END_REASON"; stop_workers "$END_REASON"; break
    fi
    [ -x "$ROOT/bin/vqcc-remote" ] && "$ROOT/bin/vqcc-remote" poll >> "$VQCC_STATE/logs/remote-poll.log" 2>&1 &
    [ -x "$ROOT/bin/vqcc-compute" ] && "$ROOT/bin/vqcc-compute" poll >> "$VQCC_STATE/logs/compute-poll.log" 2>&1 &
  fi

  # Submit when the verified best improved (deterministic policy in harness/submit.py): every
  # 2 hours and once more 15 minutes before the window closes. The daily cap is enforced there.
  if [ "$FORCE" = 0 ]; then
    left=$(vqcc_min_to_end)
    if { [ $(( now - LAST_SUBMIT_TRY )) -ge 7200 ] && [ $(( now - START_TS )) -ge 5400 ]; } || \
       { [ "$SUBMITTED_TONIGHT" = 0 ] && [ "$left" -le 15 ]; }; then
      LAST_SUBMIT_TRY=$now
      "$ROOT/bin/vqcc-model" sync >> "$VQCC_STATE/logs/model.log" 2>&1
      [ "$left" -le 15 ] && SUBMITTED_TONIGHT=1
      "$ROOT/bin/vqcc-submit" --auto >> "$VQCC_STATE/logs/submit.log" 2>&1
      vqcc_log "supervisor: vqcc-submit --auto exit=$? ($(tail -n 1 "$VQCC_STATE/logs/submit.log"))"
    fi
  fi
done

"$ROOT/bin/vqcc-model" sync >> "$VQCC_STATE/logs/model.log" 2>&1
"$ROOT/bin/vqcc-submit" --sync >> "$VQCC_STATE/logs/submit.log" 2>&1  # Kaggle public LB of our submissions
"$ROOT/bin/vqcc-standing" > "$VQCC_STATE/logs/standing.log" 2>&1  # rank / medal gap for the report
"$ROOT/bin/vqcc-report" >> "$VQCC_STATE/logs/report.log" 2>&1
herdr session stop "$S" --json >/dev/null 2>&1
vqcc_log "supervisor: night $NIGHT_ID done"
rm -f "$LOCK"; unload_if_disabled
exit 0
}
